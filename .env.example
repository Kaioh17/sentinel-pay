# dev | prod. Selects the Docker build target and which compose files load.
ENVIRONMENT=dev
# dev: base + dev override (hot reload, exposed db/redis ports). prod: base only.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Postgres (default dev credentials - CHANGE for prod)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinelpay

# Redis
REDIS_PASSWORD=redis

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend (VITE_API_URL is baked in at build time)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
